{
  "name": "spencerharston.com",
  "version": "3.0.0",
  "description": "The personal website of Spencer Harston",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint \"./**/*.js\"",
    "lint:fix": "eslint \"./**/*.js\" --fix",
    "prettier": "prettier . --check",
    "prettier:write": "prettier . --write",
    "start": "run-p start:*",
    "start:eleventy": "eleventy --serve",
    "start:postcss": "postcss src/assets/css/*.css --dir dist/assets/css --watch --verbose",
    "build": "run-s clean build:eleventy build:postcss",
    "build:eleventy": "eleventy",
    "build:postcss": "postcss src/assets/css/*.css --dir dist/assets/css",
    "clean": "rm -rf ./dist",
    "prepare": "husky",
    "media": "scripts/media-manager.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sphars/spencerharston.com.git"
  },
  "author": "Spencer Harston",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sphars/spencerharston.com/issues"
  },
  "homepage": "https://github.com/sphars/spencerharston.com#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.25.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/zalando-sans": "^5.3.0",
    "@inquirer/prompts": "^7.10.1",
    "@sardine/eleventy-plugin-external-links": "^1.4.0",
    "@tabler/icons": "^3.50.0",
    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "eleventy-plugin-og-image": "^4.0.1",
    "eleventy-plugin-reading-time": "^0.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-eleventy-img": "^0.10.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-image-figures": "^2.1.1",
    "npm-run-all2": "^9.0.2",
    "postcss": "^8.5.15",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
